# 应用镜像 tag 变量。复制为 images.env，填入构建脚本实际产出的不可变标签；
# 禁止使用裸 latest。若内网使用私有 Registry，建议最终改为 digest 固定。
PLATFORM_API_IMAGE=enterprise-rag/platform-api:<version>-<short-sha>
RAG_QUERY_SERVICE_IMAGE=enterprise-rag/rag-query-service:<version>-<short-sha>
INGESTION_WORKER_IMAGE=enterprise-rag/ingestion-worker:<version>-<short-sha>
SCHEDULER_WORKER_IMAGE=enterprise-rag/scheduler-worker:<version>-<short-sha>
DOCUMENT_PARSER_SERVICE_IMAGE=enterprise-rag/document-parser-service:<version>-<short-sha>
WEB_CONSOLE_IMAGE=enterprise-rag/web-console:<version>-<short-sha>
