# 复制为 runtime.env。这里不保存真实密钥；所有“必须替换”都必须在启动前处理。
APP_ENV=production
PROVIDER_PROFILE=intranet-production
RAG_DATA_ROOT=./data
WEB_BIND=8080

# 随包 PostgreSQL。若改用企业 PostgreSQL，同时修改 DATABASE_URL。
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=必须替换为高强度数据库密码
DATABASE_URL=postgresql://rag:必须替换为URL编码后的同一密码@postgres:5432/rag?sslmode=disable

# 两个 Redis 的职责不同：cache 可丢，bullmq 保存任务；不要合并 DB 或启用淘汰。
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_BULLMQ_URL=redis://redis-bullmq:6379/0

# MINIO_ENDPOINT 必须是浏览器和容器都能解析的内网 FQDN，因为预签名上传 URL 会带这个 Host。
MINIO_ENDPOINT=http://必须替换为部署主机或MinIO的内网FQDN:9000
MINIO_ACCESS_KEY=必须替换
MINIO_SECRET_KEY=必须替换为至少8位的高强度密钥
MINIO_UPLOAD_BUCKET=rag-quarantine
MINIO_DERIVED_BUCKET=rag-derived
MINIO_CORS_ORIGIN=http://必须替换为Web访问域名:8080

# 认证网关必须先删除浏览器自带同名 Header，再注入企业登录得到的 userId 和 roles。
# 应用容器端口不对宿主机暴露；生产流量只允许从受信网关进入 Web/Nginx。
AUTH_MODE=trusted-header
AUTH_USER_HEADER=X-Authenticated-User
AUTH_ROLES_HEADER=X-Authenticated-Roles
AUTH_ROLES_SEPARATOR=,
AUTH_TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8
AUTH_HEADER_SIGNATURE_ENABLED=false
AUTH_HEADER_SIGNATURE_SECRET=

SCANNER_ADAPTER=builtin
SCANNER_PROFILE_ID=builtin-content-safety-v1
SCANNER_REVISION=1.0.0
PARSER_ADAPTER=http
PARSER_BASE_URL=http://document-parser-service:8104
PARSER_PROFILE_ID=node-multi-parser-intranet-v1
PARSER_REVISION=1.1.0
PARSER_PROTOCOL_VERSION=2
PARSER_MAX_CONCURRENCY=2
PARSER_TEMP_ROOT=/app/.data
PARSER_ALLOWED_SOURCE_HOSTS=必须替换为MinIO的内网FQDN
FILE_MAX_EXPANDED_TABLE_CELLS=10000000
FILE_MAX_TABLE_ROWS=100000
FILE_MAX_TABLE_COLUMNS=16384
FILE_MAX_TABLE_SPAN=10000
FILE_MAX_OUTPUT_CHARACTERS=50000000

# 内网 PaddleOCR，协议必须通过 docs/contracts/provider-http-contracts.md 的契约测试。
OCR_ADAPTER=http
OCR_BASE_URL=http://必须替换为PaddleOCR地址
OCR_API_KEY=
OCR_MODEL_ID=必须替换为模型ID
OCR_PROFILE_ID=paddleocr-intranet-production-v1
OCR_REVISION=必须替换为实际版本
OCR_PROTOCOL_VERSION=2
OCR_CAPABILITIES=PAGE_SELECTIVE,REGION_TARGET,EMBEDDED_IMAGE_TARGET,WHOLE_IMAGE_TARGET

# OpenAI-compatible LLM。没有鉴权可以留空 LLM_API_KEY。
LLM_ADAPTER=openai-compatible
LLM_BASE_URL=http://必须替换为LLM网关地址/v1
LLM_API_KEY=
LLM_MODEL_ID=必须替换为模型ID
LLM_PROFILE_ID=internal-llm-production-v1
LLM_REVISION=必须替换为实际版本
LLM_PROTOCOL_VERSION=1

EMBEDDING_ADAPTER=http
EMBEDDING_BASE_URL=http://必须替换为Embedding地址
EMBEDDING_API_KEY=
EMBEDDING_MODEL_ID=必须替换为模型ID
EMBEDDING_PROVIDER_NAME=必须替换为服务名称
EMBEDDING_PROFILE_ID=embedding-intranet-production-v1
EMBEDDING_REVISION=必须替换为实际版本
EMBEDDING_PROTOCOL_VERSION=1
EMBEDDING_DENSE_DIMENSION=1024
EMBEDDING_OUTPUT_MODE=dense,sparse
EMBEDDING_TOKENIZER_REVISION=必须替换为实际版本
EMBEDDING_SPARSE_FORMAT_VERSION=必须替换为稀疏格式版本
EMBEDDING_DOCUMENT_TEMPLATE_VERSION=document-v1
EMBEDDING_QUERY_TEMPLATE_VERSION=query-v1
EMBEDDING_MAX_BATCH_TOKENS=32768
EMBEDDING_MAX_CONCURRENCY=4
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_MAX_QUEUED_ITEMS=5000

RERANKER_ADAPTER=http
RERANKER_BASE_URL=http://必须替换为Reranker地址
RERANKER_API_KEY=
RERANKER_MODEL_ID=必须替换为模型ID
RERANKER_PROFILE_ID=reranker-intranet-production-v1
RERANKER_REVISION=必须替换为实际版本
RERANKER_PROTOCOL_VERSION=1

VECTOR_STORE_ADAPTER=milvus
VECTOR_STORE_PROFILE_ID=milvus-intranet-production-v1
# 使用随包 Milvus 时填 milvus:19530；使用企业 Milvus 时填其内网地址。
MILVUS_ADDRESS=必须替换为企业Milvus地址:19530
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_TOKEN=
MILVUS_DATABASE=rag
MILVUS_TLS_ENABLED=false
MILVUS_COLLECTION_PREFIX=rag_chunks
MILVUS_ACTIVE_ALIAS=rag_chunks_active

# 生成方式见 README；Base64 解码后必须恰好 32 字节。
RUN_CONTENT_STORAGE=AES_256_GCM
RUN_CONTENT_ENCRYPTION_KEY=必须替换为Base64编码的32字节密钥
RUN_CONTENT_RETENTION_DAYS=30
RUN_FLOW_VERSION=rag-flow-v1
RUN_POLICY_VERSION=safe-answer-policy-v1
RUN_PROMPT_PROFILE_ID=rag-prompt-v1
RUN_VALIDATOR_PROFILE_ID=answer-validator-v1
RUN_DEADLINE_SECONDS=120
RUN_EVENT_RETENTION_SECONDS=86400
RUN_EVENT_STREAM_MAX_LENGTH=10000
RUN_EVENT_PUBLISH_BATCH_SIZE=100
RUN_EVENT_PUBLISH_LEASE_SECONDS=30
RUN_STREAM_TICKET_TTL_SECONDS=60
RUN_SSE_HEARTBEAT_SECONDS=15
RUN_SHORT_WINDOW_MESSAGES=20
RUN_MAINTENANCE_INTERVAL_SECONDS=60
RUN_MAINTENANCE_BATCH_SIZE=100

RETRIEVAL_PROFILE_ID=hybrid-medium-v1
RETRIEVAL_INITIAL_TOP_K=40
RETRIEVAL_FINAL_TOP_K=12
RETRIEVAL_RRF_K=60
RETRIEVAL_DENSE_WEIGHT=0.65
RETRIEVAL_SPARSE_WEIGHT=0.35
RETRIEVAL_MAX_PER_DOCUMENT=3
RETRIEVAL_MAX_PER_SECTION=2
RETRIEVAL_MINIMUM_RESULTS=3
RETRIEVAL_MAX_ROUNDS=2
RETRIEVAL_QUERY_CACHE_TTL_SECONDS=600

ANSWER_CONTEXT_TOKEN_BUDGET=12000
ANSWER_CONTEXT_MAX_PER_DOCUMENT=2
ANSWER_MIN_CONFIDENCE=0.58
ANSWER_LLM_EVIDENCE_RERANK_ENABLED=true
ANSWER_SEMANTIC_JUDGE_ENABLED=true
ANSWER_RERANK_FALLBACK_ENABLED=true
ANSWER_STRICT_STREAMING=true
ANSWER_MAX_REGENERATIONS=1
ANSWER_EXECUTION_INTERVAL_MS=1000
ANSWER_EXECUTION_BATCH_SIZE=10
ANSWER_EXECUTION_LEASE_SECONDS=60
ANSWER_CITATION_PREVIEW_CHARS=1200

EVALUATION_WORKER_INTERVAL_MS=2000
EVALUATION_WORKER_BATCH_SIZE=5
EVALUATION_WORKER_LEASE_SECONDS=60
EVALUATION_MAX_ATTEMPTS=3
EVALUATION_PENDING_POLL_SECONDS=2
TRAFFIC_GLOBAL_RATE_PER_MINUTE=600
TRAFFIC_GLOBAL_CONCURRENCY=200
TRAFFIC_USER_RATE_PER_MINUTE=60
TRAFFIC_USER_CONCURRENCY=4
TRAFFIC_ROLE_RATE_PER_MINUTE=300
TRAFFIC_ROLE_CONCURRENCY=100
TRAFFIC_SPACE_RATE_PER_MINUTE=300
TRAFFIC_SPACE_CONCURRENCY=50
TRAFFIC_LEASE_SECONDS=120

INDEXING_OVERALL_DEADLINE_MS=900000
INDEXING_VECTOR_WRITE_BATCH_SIZE=256
INDEXING_VECTOR_WRITE_MAX_ATTEMPTS=3
INDEXING_MANIFEST_RETENTION_DAYS=30
INDEXING_RECONCILE_INTERVAL_SECONDS=3600
INDEXING_MAINTENANCE_LEASE_SECONDS=300
INDEXING_MAINTENANCE_BATCH_SIZE=10
INDEXING_MAINTENANCE_MAX_ATTEMPTS=5
INDEXING_ROLLOUT_MAX_CASES=50
INDEXING_ROLLOUT_EVALUATION_TOP_K=5
INDEXING_ROLLOUT_MINIMUM_RECALL=0.9
INDEXING_ROLLOUT_LEASE_SECONDS=600
INDEXING_ROLLOUT_MAX_ATTEMPTS=3
