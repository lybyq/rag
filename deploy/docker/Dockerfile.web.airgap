ARG NODE_BUILDER_IMAGE=registry.invalid/rag/node-pnpm:22.20.0-11.19.0-bookworm
ARG NGINX_RUNTIME_IMAGE=registry.invalid/rag/nginx-unprivileged:1.29.1
FROM ${NODE_BUILDER_IMAGE} AS builder

WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web-console/package.json apps/web-console/package.json
COPY .offline/pnpm-store /opt/rag/pnpm-store
# 与后端相同：只信任已经过门禁的锁文件和本地 Store，不向 Registry 请求证明元数据。
RUN pnpm install --offline --frozen-lockfile --trust-lockfile --store-dir /opt/rag/pnpm-store
COPY tsconfig.json tsconfig.base.json ./
COPY libs/contracts ./libs/contracts
COPY apps/web-console ./apps/web-console
ARG VITE_QUERY_API_URL=/query-probe/api/v1/health/live
ARG VITE_INGESTION_PROBE_URL=/ingestion-probe/api/v1/health/live
ARG VITE_SCHEDULER_PROBE_URL=/scheduler-probe/api/v1/health/live
ENV VITE_QUERY_API_URL=${VITE_QUERY_API_URL}
ENV VITE_INGESTION_PROBE_URL=${VITE_INGESTION_PROBE_URL}
ENV VITE_SCHEDULER_PROBE_URL=${VITE_SCHEDULER_PROBE_URL}
RUN pnpm --filter @rag/web-console build

FROM ${NGINX_RUNTIME_IMAGE} AS runtime
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/web-console/dist /usr/share/nginx/html
EXPOSE 8080
