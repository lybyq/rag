DOCUMENT_PARSER_SERVICE_IMAGE=registry.invalid/rag/document-parser-service:replace-with-digest
WEB_CONSOLE_IMAGE=registry.invalid/rag/web-console:replace-with-digest
POSTGRES_IMAGE=registry.invalid/rag/postgres:replace-with-digest
REDIS_IMAGE=registry.invalid/rag/redis:replace-with-digest
MINIO_IMAGE=registry.invalid/rag/minio:replace-with-digest
