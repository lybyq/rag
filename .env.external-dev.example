# 复制为 `.env.external-dev` 后由 PROVIDER_PROFILE=external-dev 在进程启动时读取。
# 不要在本文件或复制后的真实文件中提交 DeepSeek Key。
APP_ENV=development
PROVIDER_PROFILE=external-dev

SCANNER_ADAPTER=builtin
SCANNER_PROFILE_ID=builtin-content-safety-v1
SCANNER_REVISION=1.0.0
PARSER_ADAPTER=http
PARSER_BASE_URL=http://localhost:8104
PARSER_PROFILE_ID=node-multi-parser-v1
PARSER_REVISION=1.0.0
PARSER_PROTOCOL_VERSION=2
PARSER_ALLOWED_SOURCE_HOSTS=localhost,127.0.0.1,minio
OCR_ADAPTER=docling
OCR_BASE_URL=http://localhost:8103
OCR_MODEL_ID=docling-ocr
OCR_PROFILE_ID=docling-ocr-dev-v1
OCR_REVISION=docling-serve-v1
OCR_PROTOCOL_VERSION=1

LLM_ADAPTER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_ID=deepseek-chat
LLM_PROFILE_ID=deepseek-external-dev-v1
LLM_REVISION=deepseek-api-current
LLM_PROTOCOL_VERSION=1

# 没有本地 BGE 服务时先跑可预测 Fixture；不得据此验收 Recall/Rerank。
EMBEDDING_ADAPTER=fixture
EMBEDDING_BASE_URL=http://localhost:8101
EMBEDDING_MODEL_ID=fixture-embedding
EMBEDDING_PROVIDER_NAME=fixture
EMBEDDING_PROFILE_ID=fixture-embedding-external-dev-v1
EMBEDDING_REVISION=1
EMBEDDING_PROTOCOL_VERSION=1
EMBEDDING_DENSE_DIMENSION=1024
EMBEDDING_OUTPUT_MODE=dense
EMBEDDING_TOKENIZER_REVISION=fixture-tokenizer-v1
EMBEDDING_SPARSE_FORMAT_VERSION=
EMBEDDING_DOCUMENT_TEMPLATE_VERSION=document-v1
EMBEDDING_QUERY_TEMPLATE_VERSION=query-v1
INDEXING_MANIFEST_RETENTION_DAYS=30
# M06 会话、异步 Run、顺序事件、SSE 与合规正文保护。
# flow/policy/prompt/validator 任一行为变化都应换新版本；已创建 Run 始终使用冻结快照。
RUN_FLOW_VERSION=rag-flow-v1
RUN_POLICY_VERSION=safe-answer-policy-v1
RUN_PROMPT_PROFILE_ID=rag-prompt-v1
RUN_VALIDATOR_PROFILE_ID=answer-validator-v1
RUN_DEADLINE_SECONDS=120
RUN_EVENT_RETENTION_SECONDS=86400
RUN_EVENT_STREAM_MAX_LENGTH=10000
RUN_EVENT_PUBLISH_BATCH_SIZE=100
RUN_EVENT_PUBLISH_LEASE_SECONDS=30
RUN_STREAM_TICKET_TTL_SECONDS=60
RUN_SSE_HEARTBEAT_SECONDS=15
RUN_SHORT_WINDOW_MESSAGES=20
RUN_CONTENT_STORAGE=AES_256_GCM
# 外网开发/CI 固定测试密钥；内网必须由 Secret 注入独立的 Base64 32 字节随机密钥。
RUN_CONTENT_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
RUN_CONTENT_RETENTION_DAYS=30
RUN_MAINTENANCE_INTERVAL_SECONDS=60
RUN_MAINTENANCE_BATCH_SIZE=100

RERANKER_ADAPTER=fixture
RERANKER_BASE_URL=http://localhost:8102
RERANKER_MODEL_ID=fixture-reranker
RERANKER_PROFILE_ID=fixture-reranker-external-dev-v1
RERANKER_REVISION=1
RERANKER_PROTOCOL_VERSION=1

VECTOR_STORE_ADAPTER=memory
VECTOR_STORE_PROFILE_ID=memory-external-dev-v1
MILVUS_ADDRESS=localhost:19530
MILVUS_DATABASE=default
MILVUS_TLS_ENABLED=false
