    { "id": "rewrite", "lane": "plan", "col": 2, "type": "backend", "label": "查询改写", "sublabel": "LLM · 可选", "width": 70 },
    { "id": "retrieve", "lane": "retrieve", "col": 3, "type": "database", "label": "混合检索", "sublabel": "Dense+Sparse", "width": 60 },
    { "id": "recheck", "lane": "retrieve", "col": 4, "type": "backend", "label": "回源+ACL", "sublabel": "PG 证据", "width": 60 },
    { "id": "rerank", "lane": "generate", "col": 4, "type": "backend", "label": "重排", "sublabel": "Reranker", "width": 70 },
    { "id": "generate", "lane": "generate", "col": 5, "type": "backend", "label": "答案生成", "sublabel": "GLM-4.7", "width": 70 },
    { "id": "cite", "lane": "return", "col": 5, "type": "backend", "label": "校验 + 引用", "sublabel": "SSE 流式" }
