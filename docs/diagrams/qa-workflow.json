    { "from": "rewrite", "to": "retrieve", "label": "改写查询", "role": "main", "route": "drop", "fromSide": "bottom", "toSide": "top" },
    { "from": "retrieve", "to": "recheck", "label": "候选回源", "role": "main", "route": "bottom-channel", "fromSide": "bottom", "toSide": "bottom" },
    { "from": "recheck", "to": "rerank", "role": "main", "route": "drop", "fromSide": "bottom", "toSide": "top" },
    { "from": "rerank", "to": "generate", "label": "Top-N 证据", "role": "main", "route": "bottom-channel", "fromSide": "bottom", "toSide": "bottom" },
    { "from": "generate", "to": "cite", "role": "main", "route": "drop", "fromSide": "bottom", "toSide": "top" },
    { "from": "recheck", "to": "retrieve", "label": "重试", "role": "return", "route": "return-left", "fromSide": "left", "toSide": "left", "labelDy": 50 }
  ],
  "cards": [
    { "dot": "cyan", "title": "查询规划", "items": ["路由区分 CHAT / KNOWLEDGE / REJECT", "非知识类问题直接返回，不进入检索", "LLM 改写为可选增强，失败保留原计划"] },
    { "dot": "emerald", "title": "混合检索", "items": ["Dense + Sparse 融合 + Redis 查询缓存", "PG 回源 + ACL 权限收窄", "结果不足最多重试 2 轮"] },
    { "dot": "rose", "title": "证据与生成", "items": ["Reranker 重排 → 证据构建 → GLM 生成", "答案校验与拒答，证据不足不硬答", "SSE 流式返回 + 引用定位"] }
  ]
