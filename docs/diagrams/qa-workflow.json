    { "id": "retrieve", "label": "检索与重排", "fromCol": 3, "toCol": 4 },
    { "id": "answer", "label": "生成与返回", "fromCol": 5, "toCol": 5, "variant": "emphasis" }
  ],
  "mainPath": ["ask", "route", "rewrite", "retrieve", "recheck", "rerank", "generate", "cite"],
  "nodes": [
    { "id": "ask", "lane": "user", "col": 0, "type": "external", "label": "提问", "sublabel": "自然语言" },
