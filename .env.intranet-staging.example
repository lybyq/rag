# 复制为 `.env.intranet-staging`；所有“请填写”占位值都会被启动校验拒绝。
APP_ENV=staging
PROVIDER_PROFILE=intranet-staging
AUTH_MODE=trusted-header
AUTH_TRUSTED_PROXY_CIDRS=10.0.0.0/8

SCANNER_ADAPTER=builtin
SCANNER_PROFILE_ID=builtin-content-safety-v1
SCANNER_REVISION=1.0.0
PARSER_ADAPTER=http
PARSER_BASE_URL=http://document-parser-service:8104
PARSER_PROFILE_ID=node-multi-parser-intranet-staging-v1
PARSER_REVISION=1.0.0
PARSER_PROTOCOL_VERSION=2
PARSER_ALLOWED_SOURCE_HOSTS=minio,minio.staging.svc
OCR_ADAPTER=http
OCR_BASE_URL=http://paddleocr.staging.svc:8080
OCR_MODEL_ID=paddleocr
OCR_PROFILE_ID=paddleocr-intranet-staging-v1
OCR_REVISION=请填写内网实际版本
OCR_PROTOCOL_VERSION=2

LLM_ADAPTER=openai-compatible
LLM_BASE_URL=http://llm-gateway.staging.svc/v1
LLM_MODEL_ID=请填写内网实际模型ID
LLM_PROFILE_ID=internal-llm-staging-v1
LLM_REVISION=请填写内网实际版本
EMBEDDING_ADAPTER=http
EMBEDDING_BASE_URL=http://bge-m3.staging.svc:8080
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_PROFILE_ID=bge-m3-intranet-staging-v1
EMBEDDING_REVISION=请填写内网实际版本
EMBEDDING_DENSE_DIMENSION=1024
EMBEDDING_OUTPUT_MODE=dense,sparse
RERANKER_ADAPTER=http
RERANKER_BASE_URL=http://bge-reranker.staging.svc:8080
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_PROFILE_ID=bge-reranker-intranet-staging-v1
RERANKER_REVISION=请填写内网实际版本
VECTOR_STORE_ADAPTER=milvus
VECTOR_STORE_PROFILE_ID=milvus-intranet-staging-v1
MILVUS_ADDRESS=milvus.staging.svc:19530
MILVUS_DATABASE=rag
