# 阅读说明（2026-09-12）：仅补充注释，以下变量值保持原样。
# MS=毫秒，SECONDS=秒，BYTES=字节；比例 0.75=75%。空值表示不填写，不是字符串 null。
# 本文件覆盖该发布模板全部变量，不代表 app-config.ts 中所有可选项。
# 纯文本 OCR、正式内网 Dense-only 与回答开关修复仍是待实施功能。
# 修改真实 .env 通常需重建相关容器，docker compose restart 不会重新注入 env。
# 模型/算法版本变化可能需重处理或重建索引；数据库 Feature Flag 可覆盖 ANSWER 默认开关。
# =============================================================================
# 内网测试 ENV 模板（external-dev + Mock Auth）
# 复制为 .env 后填写；.env 禁止提交 Git。
#
# Profile=external-dev / APP_ENV=development：让 libs/config/src/app-config.ts 放行
# AUTH_MODE=mock（生产/内网 Profile 会 fail-closed 拒绝 mock，该安全校验保留未动）。
# 其余 Provider 全部连接真实内网服务，不用 fixture/memory Adapter。
#
# 所有 <...> 占位符必须替换。start 脚本会扫描占位符，未替换将拒绝启动。
# 不能把真实密码提交到本文件；密钥在运行时填入 .env。
# =============================================================================

# ---- 基础环境（external-dev 必须配 development）----
# 【大白话】运行环境；development 用于联调。正式上线需与部署 Profile 和认证方式一起切换。
APP_ENV=development
# 【大白话】整套部署策略；当前 external-dev 允许 Mock、Dense-only，正式内网 Profile 支持 Dense-only 是待实施项。
PROVIDER_PROFILE=external-dev
# 【大白话】服务在日志/监控中的名字；Compose 为每个应用覆盖它。
APP_NAME=platform-api
# 【大白话】应用 HTTP 端口；Compose 分服务覆盖，不是网页对外端口。
HTTP_PORT=3000
# 【大白话】后台 Worker 健康端口；Compose 分别覆盖为 3002、3003。
PROBE_PORT=3002
# 【大白话】日志详细程度；一般 info，排障用 debug，仍不可记录敏感正文。
LOG_LEVEL=info
# 【大白话】依赖健康检查最多等多久；3000 毫秒是 3 秒。
DEPENDENCY_HEALTH_TIMEOUT_MS=3000

# ---- 临时 Mock 鉴权（内网无统一认证服务时使用；勿用于生产）----
# 【大白话】身份模式；mock 是测试身份，正式使用需接可信用户与角色。
AUTH_MODE=mock
# 【大白话】默认测试用户编号，必须存在于下面的预设列表。
AUTH_MOCK_PRESET_ID=dev-admin
# 【大白话】选择测试用户的请求头名，仅 Mock 模式使用。
AUTH_MOCK_SELECTION_HEADER=X-RAG-Mock-User
# 【大白话】测试用户 JSON；userId 是身份、roles 是角色，当前预设为管理员。
AUTH_MOCK_PRESETS_JSON=[{"presetId":"dev-admin","label":"测试管理员","userId":"dev-admin","roles":["SYSTEM_ADMIN"]}]
# 【大白话】企业角色到项目角色的映射文件路径；容器内要有该文件。
AUTH_ROLE_MAPPING_FILE=config/role-mapping.yaml

# ---- PostgreSQL（内网真实地址；密码中的 @/:/# 等字符必须 URL 编码）----
# 【大白话】PG 连接串，存权限、文档、任务和发布事实；密码特殊字符需 URL 编码，TLS 按真实环境配置。
DATABASE_URL=postgresql://<pg-user>:<url-encoded-password>@<pg-host>:5432/<database>?sslmode=disable

# ---- 两个 Redis（用户已说明内网提供两个独立实例）----
# Cache Redis 可以按企业规范设置淘汰策略；BullMQ Redis 必须持久化并建议 noeviction。
# 两个实例各自使用 /0 即可，不再错误地写成同一实例的 /0、/1。
# 若 Redis 没有密码，URL 写成 redis://<host>:6379/0，不要保留冒号和 @。
# 【大白话】缓存 Redis 地址，放可重建的缓存等数据；独立于任务 Redis。
REDIS_CACHE_URL=redis://:<cache-redis-password>@<cache-redis-host>:6379/0
# 【大白话】队列 Redis 地址；持久化并使用 noeviction，不能随意清库。
REDIS_BULLMQ_URL=redis://:<bullmq-redis-password>@<bullmq-redis-host>:6379/0

# ---- MinIO / S3 兼容对象存储（上传闭环必需，不能省略）----
# 用户当前列出的外部服务里没有对象存储；没有它只能启动部分服务，无法完成上传、解析和证据链。
# MINIO_ENDPOINT 的 Host 必须同时能被容器和用户浏览器解析，因为预签名上传 URL 会携带该 Host。
# 【大白话】对象存储地址，放原文件和派生文件；浏览器和容器都要能访问。
MINIO_ENDPOINT=http://<minio-or-s3-host>:9000
# 【大白话】对象存储访问账号，配置真实运行 .env，不提交密钥。
MINIO_ACCESS_KEY=<minio-access-key>
# 【大白话】对象存储密钥，与访问账号配套。
MINIO_SECRET_KEY=<minio-secret-key>
# 【大白话】原始文件桶名；有历史文件后不要随意改，否则旧对象定位会失败。
MINIO_UPLOAD_BUCKET=rag-quarantine
# 【大白话】解析快照等派生对象桶名；旧证据也可能依赖它。
MINIO_DERIVED_BUCKET=rag-derived
# true：bootstrap 幂等建桶；若账号无建桶权限，先由管理员建桶后改为 false。
# 【大白话】true 启动时幂等建桶；无建桶权限则管理员先建桶再填 false，不是禁用存储。
STORAGE_INIT_ENABLED=true
# 【大白话】上传会话有效期；3600 秒为 1 小时。
UPLOAD_SESSION_TTL_SECONDS=3600
# 【大白话】临时上传链接有效期；900 秒为 15 分钟，过期需重新申请。
UPLOAD_PRESIGNED_URL_TTL_SECONDS=900
# 【大白话】上传会话最多文件数；100 不代表同时解析 100 份。
UPLOAD_MAX_FILES_PER_SESSION=100
# 【大白话】单文件上传上限，当前 2 GiB；Parser 只允许 256 MiB，能上传不等于能解析。
UPLOAD_MAX_FILE_BYTES=2147483648
# 【大白话】达到分片策略大小后用分片；16777216 为 16 MiB。
UPLOAD_MULTIPART_THRESHOLD_BYTES=16777216
# 【大白话】每个上传分片大小，8388608 为 8 MiB；太大增加失败重传成本。
UPLOAD_PART_SIZE_BYTES=8388608
# 【大白话】入库任务领取租约；120 秒，需续租，不是整个任务超时。
INGESTION_LEASE_SECONDS=120
# Web Console 访问 Origin；MinIO CORS 必须允许它。
# 【大白话】允许的页面源，含协议和端口、不含路径；对象存储 CORS 也需允许它。
CORS_ALLOWED_ORIGINS=http://<rag-server-host>:8080

# ---- 文件解析与 OCR ----
# 【大白话】builtin 使用内置安全规则，没有病毒特征库。
SCANNER_ADAPTER=builtin
# 【大白话】这项能力的方案身份，用于快照、版本校验和追溯；不是地址。改实现时按迁移方案更新，不能随意改名绕过校验。
SCANNER_PROFILE_ID=builtin-content-safety-v1
# 【大白话】这项服务/算法的不可变版本，需匹配真实实现；语义升级后更新并按需重处理/重建索引，不能伪造版本。
SCANNER_REVISION=1.0.0
# 【大白话】单次安全检查超时；60000 为 60 秒。
SCANNER_REQUEST_TIMEOUT_MS=60000

# 【大白话】http 调项目自带 Node Parser 服务。
PARSER_ADAPTER=http
# 容器内通过 Compose 网络访问自带解析服务。
# 【大白话】Parser 地址；Compose 服务名仅容器网络可用，本地运行要改可达地址。
PARSER_BASE_URL=http://document-parser-service:8104
# 【大白话】Parser 调用密钥，无配置可空；调用方与服务端保持一致。
PARSER_API_KEY=
# 【大白话】这项能力的方案身份，用于快照、版本校验和追溯；不是地址。改实现时按迁移方案更新，不能随意改名绕过校验。
PARSER_PROFILE_ID=node-multi-parser-intranet-v1
# 【大白话】这项服务/算法的不可变版本，需匹配真实实现；语义升级后更新并按需重处理/重建索引，不能伪造版本。
PARSER_REVISION=1.1.0
# 【大白话】Parser 契约版本，当前 2；不是算法版本。
PARSER_PROTOCOL_VERSION=2
# 【大白话】一次解析请求超时；180000 为 3 分钟，仍受总 Deadline 限制。
PARSER_REQUEST_TIMEOUT_MS=180000
# 【大白话】解析响应上限，104857600 为 100 MiB；不是输入文件大小。
PARSER_MAX_RESPONSE_BYTES=104857600
# 容器内固定为 /app/.data（由 tmpfs 挂载），不能改成不存在的路径。
# 【大白话】临时目录；Docker 用 /app/.data，本地运行改为 D 盘可写路径。
PARSER_TEMP_ROOT=/app/.data
# 只填 MinIO 主机名，不填协议、端口或路径；多个用逗号分隔。
# 【大白话】允许下载原文件的主机名白名单，逗号分隔；不填协议、端口或路径。
PARSER_ALLOWED_SOURCE_HOSTS=<minio-or-s3-host>
# 【大白话】Parser 输入上限，268435456 为 256 MiB；调大前评估内存和解压规模。
PARSER_MAX_INPUT_BYTES=268435456
# 【大白话】归档最多文件条目数，防解压资源耗尽；不是文档页数。
PARSER_MAX_ARCHIVE_ENTRIES=20000
# 【大白话】单个归档 XML 上限，33554432 为 32 MiB。
PARSER_MAX_XML_ENTRY_BYTES=33554432

# 请求仍使用项目 /v1/ocr 的 source + targets JSON；如果内网要求文件/Base64/URL 直传，需要按真实样例新增请求 Adapter。
# 【大白话】http 支持平台结构化响应，也支持把单目标的纯文本响应安全收敛到平台契约。
OCR_ADAPTER=http
# 【大白话】OCR 网关地址，当前追加 /v1/ocr；必须匹配请求/响应契约。
OCR_BASE_URL=http://<paddleocr-gateway-host>:<port>
# 【大白话】OCR 服务调用密钥，无鉴权可留空。
OCR_API_KEY=
# 【大白话】OCR 真实模型名称，用于配置和追溯；不会自动下载模型。
OCR_MODEL_ID=<paddleocr-model-id>
# 【大白话】这项能力的方案身份，用于快照、版本校验和追溯；不是地址。改实现时按迁移方案更新，不能随意改名绕过校验。
OCR_PROFILE_ID=paddleocr-intranet-v1
# 【大白话】这项服务/算法的不可变版本，需匹配真实实现；语义升级后更新并按需重处理/重建索引，不能伪造版本。
OCR_REVISION=<paddleocr-immutable-revision>
# 【大白话】项目 OCR 契约版本，2 不是 PaddleOCR 软件大版本。
OCR_PROTOCOL_VERSION=2
# 【大白话】OCR 返回形状：platform-json=完整项目契约；text=HTTP 纯文本；json-string=JSON 字符串；json-text-field=JSON 对象的文本字段。抓包后在 text/json-string 中选准。
OCR_RESPONSE_FORMAT=text
# 【大白话】仅 json-text-field 使用，例如响应 {"text":"正文"} 就填 text；只支持顶层字段，不猜嵌套路径。
OCR_JSON_TEXT_FIELD=text
# 【大白话】单次 OCR 超时；180000 为 3 分钟，调大不能解决响应不兼容。
OCR_REQUEST_TIMEOUT_MS=180000

# 【大白话】归档嵌套深度上限，防多层压缩风险。
FILE_MAX_ARCHIVE_DEPTH=3
# 【大白话】解压大小相对压缩大小的倍数上限；100 为百倍。
FILE_MAX_COMPRESSION_RATIO=100
# 【大白话】文档页/格式内容单元数量上限；2000 不是性能保证。
FILE_MAX_PAGES=2000
# 【大白话】图片累计像素预算；500000000 为 5 亿像素，非字节数。
FILE_MAX_TOTAL_PIXELS=500000000
# 【大白话】真实单元格预算；展开后的单元格另有预算，改本项不会解除所有限制。
FILE_MAX_TABLE_CELLS=5000000
# 【大白话】原生文本覆盖度参考阈值；还结合页类型等判断，不是 OCR 准确率。
OCR_TEXT_COVERAGE_THRESHOLD=0.02
# 【大白话】OCR 最低置信度；需与质量阶段阈值一致。纯文本缺置信度不能伪造为 1。
OCR_MIN_CONFIDENCE=0.75
# 【大白话】处理最多尝试次数，含首次；3 是总共三次，仅可恢复错误重试。
PROCESSING_MAX_ATTEMPTS=3

# ---- 知识加工与质量 ----
# 【大白话】这项能力的方案身份，用于快照、版本校验和追溯；不是地址。改实现时按迁移方案更新，不能随意改名绕过校验。
CHUNKER_PROFILE_ID=structure-aware-medium-v1
# 【大白话】这项服务/算法的不可变版本，需匹配真实实现；语义升级后更新并按需重处理/重建索引，不能伪造版本。
CHUNKER_REVISION=1.0.0
# 【大白话】分块 Token 计数实现；cl100k 是本地词表，不等同于 GLM/BGE 官方词表。
TOKENIZER_ADAPTER=cl100k
# 【大白话】这项能力的方案身份，用于快照、版本校验和追溯；不是地址。改实现时按迁移方案更新，不能随意改名绕过校验。
TOKENIZER_PROFILE_ID=cl100k-base-local
# 【大白话】检索子块 Token 上限；512，改动需重处理旧文档。
CHUNK_CHILD_MAX_TOKENS=512
# 【大白话】补上下文的父块上限；1500，不保证整块进入生成上下文。
CHUNK_PARENT_MAX_TOKENS=1500
# 【大白话】块间重叠 Token 数；64 保留边界信息，过大增加重复成本。
CHUNK_OVERLAP_TOKENS=64
# 【大白话】SUPPRESS 抑制重复块进入索引，不是删除原文件。
CHUNK_DEDUP_MODE=SUPPRESS
# 【大白话】质量规则版本标识；规则变化应更新并验收。
QUALITY_RULE_VERSION=quality-medium-v1
# 【大白话】非空块比例的质量参考线；0.6 为 60%，不是识别准确率。
QUALITY_MIN_NON_EMPTY_BLOCK_RATIO=0.6
# 【大白话】非空块过少时拒绝参考线；0.2 为 20%。
QUALITY_REJECT_NON_EMPTY_BLOCK_RATIO=0.2
# 【大白话】质量审核的 OCR 阈值，必须与 OCR_MIN_CONFIDENCE 一致；未知置信度策略待适配。
QUALITY_MIN_OCR_CONFIDENCE=0.75
# 【大白话】乱码比例正常参考上限；0.03 为 3%，超出影响质量判定。
QUALITY_MAX_GARBLED_RATIO=0.03
# 【大白话】严重乱码拒绝参考线；0.15 为 15%。
QUALITY_REJECT_GARBLED_RATIO=0.15
# 【大白话】重复内容比例参考上限；0.4 为 40%，不要只为通过盲目调高。
QUALITY_MAX_DUPLICATE_RATIO=0.4
# 【大白话】达到多少 Block 后检查标题结构；20 不是自动每 20 块插标题。
QUALITY_REQUIRE_HEADING_AFTER_BLOCKS=20

# ---- LLM（OpenAI 兼容内网网关）----
# 【大白话】openai-compatible 用 chat/completions；http 用项目自定义网关协议。
LLM_ADAPTER=openai-compatible
# 【大白话】GLM/vLLM 基础地址，通常带 /v1；代码追加 chat/completions。
LLM_BASE_URL=http://<glm-gateway-host>:<port>/v1
# 【大白话】模型 Token；无鉴权可空，不把占位符当实际密钥。
LLM_API_KEY=<glm-api-key-or-empty-token>
# 【大白话】请求 model 值，必须匹配 vLLM 实际对外模型名。
LLM_MODEL_ID=glm-4.7
# 【大白话】这项能力的方案身份，用于快照、版本校验和追溯；不是地址。改实现时按迁移方案更新，不能随意改名绕过校验。
LLM_PROFILE_ID=glm-4.7-intranet-integration-v1
# 【大白话】这项服务/算法的不可变版本，需匹配真实实现；语义升级后更新并按需重处理/重建索引，不能伪造版本。
LLM_REVISION=<glm-4.7-immutable-revision>
# 【大白话】项目模型契约标识，不是 GLM 4.7 或 vLLM 版本。
LLM_PROTOCOL_VERSION=1
# 【大白话】连接超时配置；当前答案 Adapter 未单独使用，实际受请求超时/Deadline 控制。
LLM_CONNECT_TIMEOUT_MS=3000
# 【大白话】单次 LLM 超时；60000 为 60 秒，一次问答可能多次调用。
LLM_REQUEST_TIMEOUT_MS=60000
# 【大白话】单次输出 Token 上限；4096 越大可能越慢，过小截断 JSON。
LLM_MAX_OUTPUT_TOKENS=4096
# 【大白话】正式答案 Draft 的输出预算；只影响答案生成。
LLM_GENERATION_MAX_OUTPUT_TOKENS=4096
# 【大白话】额外 LLM 证据重排的短输出预算；关闭对应开关后不会调用。
LLM_RERANK_MAX_OUTPUT_TOKENS=1024
# 【大白话】语义 Judge 的短输出预算；关闭对应开关后不会调用。
LLM_JUDGE_MAX_OUTPUT_TOKENS=1024
# 【大白话】response-format 会发送 JSON 模式参数；vLLM 若明确报不支持 response_format，再改为 prompt-only，返回仍会严格做 JSON 校验。
LLM_JSON_MODE=response-format
# 【大白话】随机程度；0.1 较稳定，调低不能保证事实正确。
LLM_TEMPERATURE=0.1

# ---- Embedding（默认只启用 Dense；确认服务支持 Sparse 契约后再开启混合检索）----
# 【大白话】http 用项目统一协议，原生 OpenAI embeddings 不一定兼容。
EMBEDDING_ADAPTER=http
# 【大白话】向量网关地址；当前调用 /health、/metadata、/v1/embeddings。
EMBEDDING_BASE_URL=http://<embedding-gateway-host>:<port>
# 【大白话】向量服务密钥，无鉴权可空。
EMBEDDING_API_KEY=
# 【大白话】实际向量模型名称；换模型需新 Profile 与索引重建。
EMBEDDING_MODEL_ID=<embedding-model-id>
# 【大白话】向量服务提供方标识，按真实 metadata 填，用于一致性核验。
EMBEDDING_PROVIDER_NAME=<embedding-provider-name>
# 【大白话】这项能力的方案身份，用于快照、版本校验和追溯；不是地址。改实现时按迁移方案更新，不能随意改名绕过校验。
EMBEDDING_PROFILE_ID=embedding-intranet-integration-v1
# 【大白话】这项服务/算法的不可变版本，需匹配真实实现；语义升级后更新并按需重处理/重建索引，不能伪造版本。
EMBEDDING_REVISION=<embedding-immutable-revision>
# 【大白话】向量服务契约版本，需与服务 metadata 匹配。
EMBEDDING_PROTOCOL_VERSION=1
# 【大白话】连接超时配置；当前 HTTP Adapter 未单独使用，以请求超时/Deadline 为准。
EMBEDDING_CONNECT_TIMEOUT_MS=3000
# 【大白话】单次向量请求超时，30000 为 30 秒。
EMBEDDING_REQUEST_TIMEOUT_MS=30000
# 【大白话】每批文本条数上限；32，还受总 Token 预算约束。
EMBEDDING_BATCH_SIZE=32
# 【大白话】向量长度，必须与实际模型及 Milvus 字段一致，不能凭名字猜。
EMBEDDING_DENSE_DIMENSION=<embedding-dense-dimension>
# 【大白话】要求的向量归一化行为，需与真实输出及 Profile 一致。
EMBEDDING_NORMALIZE_DENSE=true
# 若服务实测支持 sparse，先创建新 Profile 并补建候选索引、对账和评测，再发布混合检索。
# 新方案才配置 dense,sparse、真实稀疏格式版本和经评测的权重（例如 0.65 / 0.35）。
# 不要只改旧运行配置：恢复查询接口不会自动补齐历史向量。Dense-only 不伪造 BGE-M3 稀疏能力。
# 【大白话】dense 为单路，dense,sparse 为双路；当前正式内网已支持 Dense-only。
EMBEDDING_OUTPUT_MODE=dense
# 【大白话】单条输入 Token 上限；8192 是模板值，需核对模型真实能力。
EMBEDDING_MAX_INPUT_TOKENS=8192
# 【大白话】向量模型的词表/计数器版本，按真实 metadata 填。
EMBEDDING_TOKENIZER_REVISION=<embedding-tokenizer-immutable-revision>
# 【大白话】稀疏格式版本；Dense-only 必须空，启用 sparse 必须填真实版本。
EMBEDDING_SPARSE_FORMAT_VERSION=
# 【大白话】文档向量化模板版本，模板变化需更新并重建向量。
EMBEDDING_DOCUMENT_TEMPLATE_VERSION=document-v1
# 【大白话】查询向量化模板版本，需与文档模板配套并评测。
EMBEDDING_QUERY_TEMPLATE_VERSION=query-v1
# 【大白话】一批总 Token 上限；32768，需不小于单条上限。
EMBEDDING_MAX_BATCH_TOKENS=32768
# 【大白话】并行向量请求上限；4 需结合实际算力调节。
EMBEDDING_MAX_CONCURRENCY=4
# 【大白话】向量调用最多尝试次数，含首次；契约错误不盲目重试。
EMBEDDING_MAX_ATTEMPTS=3
# 【大白话】重试起始退避毫秒数；250 为四分之一秒。
EMBEDDING_RETRY_BASE_DELAY_MS=250
# 【大白话】向量等待队列条目上限；5000 用于背压，不是 Redis 全局容量。
EMBEDDING_MAX_QUEUED_ITEMS=5000

# ---- Reranker（BGE Reranker）----
# 【大白话】http 用项目重排协议；原生 BGE 返回需映射候选索引和分数。
RERANKER_ADAPTER=http
# 【大白话】重排基础地址；当前用 /health、/v1/metadata、/v1/rerank。
RERANKER_BASE_URL=http://<reranker-gateway-host>:<port>
# 【大白话】重排服务密钥，无鉴权可空。
RERANKER_API_KEY=
# 【大白话】真实重排模型名称，需与网关身份一致。
RERANKER_MODEL_ID=<reranker-model-id>
# 【大白话】这项能力的方案身份，用于快照、版本校验和追溯；不是地址。改实现时按迁移方案更新，不能随意改名绕过校验。
RERANKER_PROFILE_ID=reranker-intranet-integration-v1
# 【大白话】这项服务/算法的不可变版本，需匹配真实实现；语义升级后更新并按需重处理/重建索引，不能伪造版本。
RERANKER_REVISION=<reranker-immutable-revision>
# 【大白话】项目重排契约版本，非模型版本。
RERANKER_PROTOCOL_VERSION=1
# 【大白话】连接超时配置；当前重排 Adapter 未独立使用，以请求超时为准。
RERANKER_CONNECT_TIMEOUT_MS=3000
# 【大白话】重排一次最多等多久；15000 为 15 秒。
RERANKER_REQUEST_TIMEOUT_MS=15000
# 【大白话】最多送入重排的候选数；50 越大算力成本越高。
RERANKER_MAX_CANDIDATES=50
# 【大白话】重排保留数量；10 不等于最终上下文证据数。
RERANKER_TOP_N=10
# 【大白话】重排输入长度限制；需符合真实模型，Child 上限应小于它。
RERANKER_MAX_INPUT_TOKENS=8192
# 【大白话】BGE 已返回 0~1 填 probability；原始分数可小于 0/大于 1 填 logit，Adapter 只做一次 Sigmoid。填错会让置信阈值失真。
RERANKER_SCORE_TYPE=probability

# ---- 索引构建与发布 ----
# 【大白话】一次索引构建总预算；900000 为 15 分钟。
INDEXING_OVERALL_DEADLINE_MS=900000
# 【大白话】Milvus 单批写入条数；256，越大单次内存/重试成本越高。
INDEXING_VECTOR_WRITE_BATCH_SIZE=256
# 【大白话】向量写入最多尝试次数，含首次；需要幂等。
INDEXING_VECTOR_WRITE_MAX_ATTEMPTS=3
# 【大白话】历史发布清单保留策略天数；30 用于回滚，不表示可删除当前事实。
INDEXING_MANIFEST_RETENTION_DAYS=30
# 【大白话】后台索引对账调度间隔；3600 为 1 小时，非发布前固定等待。
INDEXING_RECONCILE_INTERVAL_SECONDS=3600
# 【大白话】索引维护任务租约；300 秒，失联按恢复策略领取。
INDEXING_MAINTENANCE_LEASE_SECONDS=300
# 【大白话】每轮索引维护任务数；10，区别于向量写入批次。
INDEXING_MAINTENANCE_BATCH_SIZE=10
# 【大白话】维护任务最大尝试次数；5。
INDEXING_MAINTENANCE_MAX_ATTEMPTS=5
# 【大白话】新 Profile/索引灰度最多评测用例数；50。
INDEXING_ROLLOUT_MAX_CASES=50
# 【大白话】灰度评测关注排名前几；5 即 Top-5。
INDEXING_ROLLOUT_EVALUATION_TOP_K=5
# 【大白话】灰度召回门槛；0.9 为 90%，非所有线上问题准确率承诺。
INDEXING_ROLLOUT_MINIMUM_RECALL=0.9
# 【大白话】灰度任务租约；600 秒为 10 分钟。
INDEXING_ROLLOUT_LEASE_SECONDS=600
# 【大白话】灰度任务最多尝试次数；3，质量失败不能靠无限重试发布。
INDEXING_ROLLOUT_MAX_ATTEMPTS=3

# ---- 会话运行与事件 ----
# 【大白话】工作流版本记录，流程变化需更新，便于审计旧 Run。
RUN_FLOW_VERSION=rag-flow-v1
# 【大白话】问答策略版本；改名字不会自动修改策略代码。
RUN_POLICY_VERSION=safe-answer-policy-v1
# 【大白话】提示词方案身份，写入 Run 快照，不是服务地址。
RUN_PROMPT_PROFILE_ID=rag-prompt-v1
# 【大白话】校验方案身份；策略改变需更新并回归。
RUN_VALIDATOR_PROFILE_ID=answer-validator-v1
# 【大白话】问答总时间预算；120 为 2 分钟，单次请求超时不能延长它。
RUN_DEADLINE_SECONDS=120
# 【大白话】运行事件缓存保留期；86400 为一天，不是正文保留期。
RUN_EVENT_RETENTION_SECONDS=86400
# 【大白话】Redis 事件 Stream 长度控制；10000 限制缓存占用。
RUN_EVENT_STREAM_MAX_LENGTH=10000
# 【大白话】每轮处理待发布事件条数；100，影响事件积压。
RUN_EVENT_PUBLISH_BATCH_SIZE=100
# 【大白话】事件发布任务领取租约；30 秒。
RUN_EVENT_PUBLISH_LEASE_SECONDS=30
# 【大白话】SSE 临时票据有效期；60 秒，票据不能泄漏。
RUN_STREAM_TICKET_TTL_SECONDS=60
# 【大白话】SSE 保活间隔；15 秒只代表连接还在，不是业务进度。
RUN_SSE_HEARTBEAT_SECONDS=15
# 【大白话】会话短窗口消息条数上限；20 不是 Token 数，不保证下游用满所有历史。
RUN_SHORT_WINDOW_MESSAGES=20
# 【大白话】AES_256_GCM 表示会话内容加密存储，需配正确密钥。
RUN_CONTENT_STORAGE=AES_256_GCM
# 即使是联调环境也不要复用公开默认值。生成 Base64 编码的 32 字节随机密钥并妥善保存；
# 数据写入后更换该值会导致历史会话无法解密。
# 【大白话】Base64 编码的 32 字节随机密钥；已有历史后不可直接换，否则无法解密，轮换需迁移。
RUN_CONTENT_ENCRYPTION_KEY=<base64-encoded-32-random-bytes>
# 【大白话】会话正文保留策略天数；30，结合后台清理及企业要求。
RUN_CONTENT_RETENTION_DAYS=30
# 【大白话】会话恢复/清理调度间隔；60 秒。
RUN_MAINTENANCE_INTERVAL_SECONDS=60
# 【大白话】每轮会话维护条目上限；100，控制 PG 负载。
RUN_MAINTENANCE_BATCH_SIZE=100

# ---- 查询规划与混合检索 ----
# 【大白话】检索策略身份；切混合检索需更新方案并评测，用于快照/缓存。
RETRIEVAL_PROFILE_ID=dense-medium-v1
# 【大白话】初始召回数参数；40，多空间/子问题合并后的总数可能不同。
RETRIEVAL_INITIAL_TOP_K=40
# 【大白话】检索后保留候选数；12，后面还有重排和上下文筛选。
RETRIEVAL_FINAL_TOP_K=12
# 【大白话】排名融合平滑常数；60 不是召回条数。
RETRIEVAL_RRF_K=60
# 【大白话】Dense 融合权重；单路用 1，需与 Sparse 权重配套。
RETRIEVAL_DENSE_WEIGHT=1
# 【大白话】Sparse 权重；单路用 0，改正数不会产生不存在的稀疏能力。
RETRIEVAL_SPARSE_WEIGHT=0
# 【大白话】检索每文档最多候选数；3，防占满但也可能遗漏长文上下文。
RETRIEVAL_MAX_PER_DOCUMENT=3
# 【大白话】每章节最多候选数；2，限制重复。
RETRIEVAL_MAX_PER_SECTION=2
# 【大白话】候选不足时策略判断参考数量；3，数量不能代替相关性。
RETRIEVAL_MINIMUM_RESULTS=3
# 【大白话】最多检索轮数；2 控制改写重试和延迟。
RETRIEVAL_MAX_ROUNDS=2
# 【大白话】查询向量缓存有效期；600 为 10 分钟，身份还需绑定版本和权限。
RETRIEVAL_QUERY_CACHE_TTL_SECONDS=600

# ---- 证据与答案生成 ----
# 【大白话】生成上下文预算；12000，当前为估算值并非 GLM 精确计数，需为提示词和输出留空间。
ANSWER_CONTEXT_TOKEN_BUDGET=12000
# 【大白话】生成上下文每文档最多证据数；2 可能排除同文档第三条关键证据。
ANSWER_CONTEXT_MAX_PER_DOCUMENT=2
# 【大白话】证据路由置信度参考线；0.58 不是实际正确概率，降低不能根治拒答。
ANSWER_MIN_CONFIDENCE=0.58
# 【大白话】低置信时额外用 LLM 重排；关闭后仍保留 BGE 专用重排。为降低等待可先 false；数据库 Feature Flag 会覆盖 env，最终值冻结进新 Run。
ANSWER_LLM_EVIDENCE_RERANK_ENABLED=false
# 【大白话】true 允许对“需要语义推断”的 Claim 再调一次 Judge；false 强制生成 DIRECT 原文型 Claim 并做确定性文字/引用校验，不会把语义 Claim 冒充通过。内网追求速度可先 false。
ANSWER_SEMANTIC_JUDGE_ENABLED=false
# 【大白话】专用重排可恢复故障时允许降级；不忽略认证/契约错误，数据库开关可覆盖。
ANSWER_RERANK_FALLBACK_ENABLED=true
# 【大白话】问答运行超过多少秒后提示“等待较久，可以取消”；只影响提示，不改变超时和进度。
ANSWER_SLOW_NOTICE_SECONDS=12
# 【大白话】当前固定 true；实时发阶段事件，校验后才发答案/引用，不能改 false 开启未校验正文。
ANSWER_STRICT_STREAMING=true
# 【大白话】当前固定 1；最多一次修复生成，加上首次共两份草稿。
ANSWER_MAX_REGENERATIONS=1
# 【大白话】答案 Worker 轮询间隔；1000 毫秒为 1 秒，过大增加排队。
ANSWER_EXECUTION_INTERVAL_MS=1000
# 【大白话】每轮领取答案任务数量；10，不等于模型可承载并发。
ANSWER_EXECUTION_BATCH_SIZE=10
# 【大白话】答案任务租约；60 秒，需续租，不是模型最大响应时长。
ANSWER_EXECUTION_LEASE_SECONDS=60
# 【大白话】引用预览字符上限；1200，不改变生成上下文长度。
ANSWER_CITATION_PREVIEW_CHARS=1200
# 【大白话】评测 Worker 调度间隔；2000 为 2 秒。
EVALUATION_WORKER_INTERVAL_MS=2000
# 【大白话】每轮领取评测任务数；5，过大可能争用在线算力。
EVALUATION_WORKER_BATCH_SIZE=5
# 【大白话】评测任务租约；60 秒。
EVALUATION_WORKER_LEASE_SECONDS=60
# 【大白话】评测最大尝试次数；3，质量不达标与网络错误分开处理。
EVALUATION_MAX_ATTEMPTS=3
# 【大白话】评测等待关联问答结果的轮询间隔；2 秒。
EVALUATION_PENDING_POLL_SECONDS=2

# ---- 在线问答速率与并发舱壁 ----
# 【大白话】全局每分钟请求上限；600 不代表模型每分钟能完成 600 次。
TRAFFIC_GLOBAL_RATE_PER_MINUTE=600
# 【大白话】全局同时问答上限；200 需按实际模型容量调整。
TRAFFIC_GLOBAL_CONCURRENCY=200
# 【大白话】每用户每分钟请求上限；60。
TRAFFIC_USER_RATE_PER_MINUTE=60
# 【大白话】每用户同时问答上限；4，不是连接数。
TRAFFIC_USER_CONCURRENCY=4
# 【大白话】角色维度每分钟请求上限；300，多层限额同时约束。
TRAFFIC_ROLE_RATE_PER_MINUTE=300
# 【大白话】角色维度同时问答上限；100。
TRAFFIC_ROLE_CONCURRENCY=100
# 【大白话】知识空间每分钟请求上限；300。
TRAFFIC_SPACE_RATE_PER_MINUTE=300
# 【大白话】知识空间同时问答上限；50。
TRAFFIC_SPACE_CONCURRENCY=50
# 【大白话】并发名额租约；120 秒，失联后可回收，需结合总 Deadline 验证续租。
TRAFFIC_LEASE_SECONDS=120

# ---- Milvus ----
# 【大白话】milvus 用真实向量库；原文与权威发布事实仍在对象存储/PG。
VECTOR_STORE_ADAPTER=milvus
# 【大白话】这项能力的方案身份，用于快照、版本校验和追溯；不是地址。改实现时按迁移方案更新，不能随意改名绕过校验。
VECTOR_STORE_PROFILE_ID=milvus-intranet-dev-v1
# SDK 地址（host:port），不是 Attu 或 HTTP 页面地址。
# 【大白话】Milvus SDK 地址 host:19530，非 Attu 页面。
MILVUS_ADDRESS=<milvus-host>:19530
# 【大白话】Milvus 用户名，按真实认证填写。
MILVUS_USERNAME=
# 【大白话】Milvus 密码，与用户名配套。
MILVUS_PASSWORD=
# 【大白话】Milvus Token 认证；按真实方式选，不随意混填冲突凭据。
MILVUS_TOKEN=
# 【大白话】Milvus 逻辑库名，rag；需实际存在或初始化，改名影响旧集合定位。
MILVUS_DATABASE=rag
# 【大白话】是否加密连接；false 明文，按真实服务 TLS 设置。
MILVUS_TLS_ENABLED=false
# 【大白话】集合命名前缀；有旧索引后不可随意改。
MILVUS_COLLECTION_PREFIX=rag_chunks
# 【大白话】各空间别名的命名前缀，不是唯一全局在线索引；发布以 PG Manifest 为准。
MILVUS_ACTIVE_ALIAS=rag_chunks_active
# 【大白话】SDK 建连超时；5000 为 5 秒。
MILVUS_CONNECT_TIMEOUT_MS=5000
# 【大白话】SDK 单次请求超时；30000 为 30 秒，非构建总超时。
MILVUS_REQUEST_TIMEOUT_MS=30000

# ---- 可观测性（内网测试默认关闭链路追踪）----
# 【大白话】是否导出链路追踪；false 不表示关闭日志、指标和 Run 记录。
OTEL_TRACES_ENABLED=false
# 关闭追踪时不会访问该默认地址；将来启用再改为真实 OTLP HTTP Endpoint。
# 【大白话】OTLP HTTP 采集器地址；容器 localhost 指容器自身，启用时改实际可达地址。
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# 【大白话】监控中对服务的分组名，方便归属同一项目。
OTEL_SERVICE_NAMESPACE=enterprise-rag

# ---- Web Console 暴露端口（仅此端口映射到宿主机）----
# 【大白话】网页宿主机入口端口；8080 映射容器 8080，改后同步访问地址/CORS。
WEB_BIND=8080
