# 进程身份：四个服务由各自 dev 脚本覆盖 APP_NAME 与端口。
APP_ENV=development
APP_NAME=platform-api
HTTP_PORT=3000
PROBE_PORT=3002
LOG_LEVEL=info
DEPENDENCY_HEALTH_TIMEOUT_MS=3000

# 本地基础设施。生产环境必须替换口令、启用 TLS，并通过密钥系统注入。
DATABASE_URL=postgresql://rag:rag-local-only@localhost:5432/rag
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_BULLMQ_URL=redis://localhost:6380/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=rag-local
MINIO_SECRET_KEY=rag-local-secret
MINIO_UPLOAD_BUCKET=rag-quarantine

# M02 浏览器直传与任务恢复。字节上限按单文件计算；S3 分片不能小于 5 MiB。
UPLOAD_SESSION_TTL_SECONDS=3600
UPLOAD_PRESIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_FILES_PER_SESSION=100
UPLOAD_MAX_FILE_BYTES=2147483648
UPLOAD_MULTIPART_THRESHOLD_BYTES=16777216
UPLOAD_PART_SIZE_BYTES=8388608
INGESTION_LEASE_SECONDS=120
MILVUS_ADDRESS=localhost:19530
MILVUS_USERNAME=
MILVUS_PASSWORD=

# 本地默认关闭 Trace 出站；有 Collector 时开启并填写基础地址。
OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=enterprise-rag
CORS_ALLOWED_ORIGINS=http://localhost:5173

# M01 身份入口。外网开发默认 Mock；production 会拒绝 Mock 启动。
AUTH_MODE=mock
AUTH_ROLE_MAPPING_FILE=config/role-mapping.yaml
AUTH_MOCK_PRESET_ID=dev-admin
AUTH_MOCK_SELECTION_HEADER=X-RAG-Mock-User
# 可覆盖为 JSON 数组；浏览器只能选择 presetId，不能提交任意 roles。
# AUTH_MOCK_PRESETS_JSON=[{"presetId":"dev-admin","label":"研发管理员","userId":"dev-admin","roles":["SYSTEM_ADMIN"]}]

# Trusted Header：生产必须由网关清除外部同名 Header 后重写，并限制直连来源。
AUTH_USER_HEADER=X-Authenticated-User
AUTH_ROLES_HEADER=X-Authenticated-Roles
AUTH_ROLES_SEPARATOR=,
AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
AUTH_HEADER_SIGNATURE_ENABLED=false
AUTH_HEADER_SIGNATURE_SECRET=
AUTH_HEADER_SIGNATURE_HEADER=X-Auth-Signature
AUTH_HEADER_TIMESTAMP_HEADER=X-Auth-Timestamp
AUTH_HEADER_MAX_SKEW_SECONDS=60

# JWT：启用时三项地址/目标必填，算法只允许受支持的非对称签名算法。
AUTH_JWT_JWKS_URL=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_USER_ID_CLAIM=sub
AUTH_JWT_ROLES_CLAIM=roles
AUTH_JWT_ALLOWED_ALGORITHMS=RS256
