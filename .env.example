# 进程身份：四个服务由各自 dev 脚本覆盖 APP_NAME 与端口。
APP_ENV=development
APP_NAME=platform-api
HTTP_PORT=3000
PROBE_PORT=3002
LOG_LEVEL=info
DEPENDENCY_HEALTH_TIMEOUT_MS=3000

# 本地基础设施。生产环境必须替换口令、启用 TLS，并通过密钥系统注入。
DATABASE_URL=postgresql://rag:rag-local-only@localhost:5432/rag
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_BULLMQ_URL=redis://localhost:6380/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=rag-local
MINIO_SECRET_KEY=rag-local-secret
MILVUS_ADDRESS=localhost:19530
MILVUS_USERNAME=
MILVUS_PASSWORD=

# 本地默认关闭 Trace 出站；有 Collector 时开启并填写基础地址。
OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=enterprise-rag
CORS_ALLOWED_ORIGINS=http://localhost:5173
