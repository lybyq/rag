{
  "openapi": "3.1.0",
  "info": {
    "title": "Enterprise RAG Query API",
    "description": "企业知识问答和证据检索 API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "getLiveness",
        "summary": "检查进程是否存活",
        "responses": {
          "200": {
            "description": "进程存活",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceHealthEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "检查关键依赖是否就绪",
        "responses": {
          "200": {
            "description": "所有关键依赖就绪",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceHealthEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "至少一个关键依赖不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceHealthEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "trustedUserHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Authenticated-User"
      },
      "mockPreset": {
        "type": "apiKey",
        "in": "header",
        "name": "X-RAG-Mock-User"
      }
    },
    "schemas": {
      "ApiError": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1
          },
          "traceId": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "NOT_FOUND",
                  "SERVICE_UNAVAILABLE",
                  "DEADLINE_EXCEEDED",
                  "INTERNAL_ERROR"
                ]
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "requestId",
          "code",
          "message",
          "retryable"
        ],
        "additionalProperties": false
      },
      "ServiceHealthEnvelope": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1
          },
          "traceId": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object",
            "properties": {
              "service": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "up",
                  "degraded",
                  "down"
                ]
              },
              "checkedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "uptimeSeconds": {
                "type": "number",
                "minimum": 0
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "up",
                        "down"
                      ]
                    },
                    "latencyMs": {
                      "type": "number",
                      "minimum": 0
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "status",
                    "latencyMs"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "service",
              "status",
              "checkedAt",
              "uptimeSeconds",
              "dependencies"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "requestId",
          "data"
        ],
        "additionalProperties": false
      }
    }
  }
}
