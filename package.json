{
  "name": "enterprise-rag-platform",
  "version": "0.1.0",
  "private": true,
  "description": "面向单一企业内网的生产级 RAG 知识库",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=11.19.0"
  },
  "scripts": {
    "build": "pnpm build:backend && pnpm --filter @rag/web-console build",
    "build:backend": "nest build platform-api && nest build rag-query-service && nest build ingestion-worker && nest build scheduler-worker",
    "build:platform-api": "nest build platform-api",
    "build:rag-query-service": "nest build rag-query-service",
    "build:ingestion-worker": "nest build ingestion-worker",
    "build:scheduler-worker": "nest build scheduler-worker",
    "dev:platform-api": "cross-env APP_NAME=platform-api HTTP_PORT=3000 nest start platform-api --watch",
    "dev:rag-query-service": "cross-env APP_NAME=rag-query-service HTTP_PORT=3001 nest start rag-query-service --watch",
    "dev:ingestion-worker": "cross-env APP_NAME=ingestion-worker PROBE_PORT=3002 nest start ingestion-worker --watch",
    "dev:scheduler-worker": "cross-env APP_NAME=scheduler-worker PROBE_PORT=3003 nest start scheduler-worker --watch",
    "dev:web": "pnpm --filter @rag/web-console dev",
    "dev:services": "concurrently -k -n platform,query,ingestion,scheduler,web -c blue,cyan,yellow,magenta,green \"pnpm dev:platform-api\" \"pnpm dev:rag-query-service\" \"pnpm dev:ingestion-worker\" \"pnpm dev:scheduler-worker\" \"pnpm dev:web\"",
    "dev:all": "pnpm dev:infra && pnpm db:migrate && pnpm seed:dev && pnpm dev:services",
    "dev:infra": "docker compose --env-file deploy/docker/images.env -f deploy/docker/docker-compose.yml up -d",
    "stop:infra": "docker compose --env-file deploy/docker/images.env -f deploy/docker/docker-compose.yml down",
    "health:infra": "docker compose --env-file deploy/docker/images.env -f deploy/docker/docker-compose.yml ps",
    "health:deep": "tsx scripts/health-check.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.check.json --noEmit && pnpm --filter @rag/web-console typecheck",
    "boundary": "dependency-cruiser apps libs --config .dependency-cruiser.cjs",
    "test": "jest --runInBand && pnpm --filter @rag/web-console test",
    "test:backend": "jest --runInBand",
    "test:contract": "jest --runInBand libs/contracts",
    "test:integration": "pnpm db:migrate && cross-env RUN_INTEGRATION_TESTS=true jest --runInBand --config test/jest-integration.config.cjs",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "migration:check": "tsx scripts/check-migrations.ts",
    "schema:check": "pnpm openapi:check",
    "docker:check": "docker compose --env-file deploy/docker/images.env -f deploy/docker/docker-compose.yml config --quiet",
    "security:audit": "pnpm audit --registry=https://registry.npmjs.org --prod --audit-level high",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm boundary && pnpm test && pnpm migration:check && pnpm build && pnpm openapi:check && pnpm docker:check"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.6",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@zilliz/milvus2-sdk-node": "3.0.4",
    "bullmq": "5.63.2",
    "ioredis": "5.8.2",
    "jsonwebtoken": "9.0.2",
    "jwks-rsa": "3.2.0",
    "minio": "8.0.7",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.15",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.1",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-vue": "10.7.0",
    "jest": "29.7.0",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vue-eslint-parser": "10.2.0"
  }
}
