# =============================================================================
# 内网测试 ENV 模板（external-dev + Mock Auth）
# 复制为 .env 后填写；.env 禁止提交 Git。
#
# Profile=external-dev / APP_ENV=development：让 libs/config/src/app-config.ts 放行
# AUTH_MODE=mock（生产/内网 Profile 会 fail-closed 拒绝 mock，该安全校验保留未动）。
# 其余 Provider 全部连接真实内网服务，不用 fixture/memory Adapter。
#
# 所有 <...> 占位符必须替换。start 脚本会扫描占位符，未替换将拒绝启动。
# 不能把真实密码提交到本文件；密钥在运行时填入 .env。
# =============================================================================

# ---- 基础环境（external-dev 必须配 development）----
APP_ENV=development
PROVIDER_PROFILE=external-dev
APP_NAME=platform-api
HTTP_PORT=3000
PROBE_PORT=3002
LOG_LEVEL=info
DEPENDENCY_HEALTH_TIMEOUT_MS=3000

# ---- 临时 Mock 鉴权（内网无统一认证服务时使用；勿用于生产）----
AUTH_MODE=mock
AUTH_MOCK_PRESET_ID=dev-admin
AUTH_MOCK_SELECTION_HEADER=X-RAG-Mock-User
AUTH_MOCK_PRESETS_JSON=[{"presetId":"dev-admin","label":"测试管理员","userId":"dev-admin","roles":["SYSTEM_ADMIN"]}]
AUTH_ROLE_MAPPING_FILE=config/role-mapping.yaml

# ---- PostgreSQL（内网真实地址；密码中的 @/:/# 等字符必须 URL 编码）----
DATABASE_URL=postgresql://<pg-user>:<url-encoded-password>@<pg-host>:5432/<database>?sslmode=disable

# ---- 两个 Redis（用户已说明内网提供两个独立实例）----
# Cache Redis 可以按企业规范设置淘汰策略；BullMQ Redis 必须持久化并建议 noeviction。
# 两个实例各自使用 /0 即可，不再错误地写成同一实例的 /0、/1。
# 若 Redis 没有密码，URL 写成 redis://<host>:6379/0，不要保留冒号和 @。
REDIS_CACHE_URL=redis://:<cache-redis-password>@<cache-redis-host>:6379/0
REDIS_BULLMQ_URL=redis://:<bullmq-redis-password>@<bullmq-redis-host>:6379/0

# ---- MinIO / S3 兼容对象存储（上传闭环必需，不能省略）----
# 用户当前列出的外部服务里没有对象存储；没有它只能启动部分服务，无法完成上传、解析和证据链。
# MINIO_ENDPOINT 的 Host 必须同时能被容器和用户浏览器解析，因为预签名上传 URL 会携带该 Host。
MINIO_ENDPOINT=http://<minio-or-s3-host>:9000
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_UPLOAD_BUCKET=rag-quarantine
MINIO_DERIVED_BUCKET=rag-derived
# true：bootstrap 幂等建桶；若账号无建桶权限，先由管理员建桶后改为 false。
STORAGE_INIT_ENABLED=true
UPLOAD_SESSION_TTL_SECONDS=3600
UPLOAD_PRESIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_FILES_PER_SESSION=100
UPLOAD_MAX_FILE_BYTES=2147483648
UPLOAD_MULTIPART_THRESHOLD_BYTES=16777216
UPLOAD_PART_SIZE_BYTES=8388608
INGESTION_LEASE_SECONDS=120
# Web Console 访问 Origin；MinIO CORS 必须允许它。
CORS_ALLOWED_ORIGINS=http://<rag-server-host>:8080

# ---- 文件解析与 OCR ----
SCANNER_ADAPTER=builtin
SCANNER_PROFILE_ID=builtin-content-safety-v1
SCANNER_REVISION=1.0.0
SCANNER_REQUEST_TIMEOUT_MS=60000

PARSER_ADAPTER=http
# 容器内通过 Compose 网络访问自带解析服务。
PARSER_BASE_URL=http://document-parser-service:8104
PARSER_API_KEY=
PARSER_PROFILE_ID=node-multi-parser-intranet-v1
PARSER_REVISION=1.0.0
PARSER_PROTOCOL_VERSION=2
PARSER_REQUEST_TIMEOUT_MS=180000
PARSER_MAX_RESPONSE_BYTES=104857600
# 容器内固定为 /app/.data（由 tmpfs 挂载），不能改成不存在的路径。
PARSER_TEMP_ROOT=/app/.data
# 只填 MinIO 主机名，不填协议、端口或路径；多个用逗号分隔。
PARSER_ALLOWED_SOURCE_HOSTS=<minio-or-s3-host>
PARSER_MAX_INPUT_BYTES=268435456
PARSER_MAX_ARCHIVE_ENTRIES=20000
PARSER_MAX_XML_ENTRY_BYTES=33554432

# PaddleOCR 必须符合 provider-http-contracts.md 的 /v1/ocr 契约（协议版本 2）。
OCR_ADAPTER=http
OCR_BASE_URL=http://<paddleocr-gateway-host>:<port>
OCR_API_KEY=
OCR_MODEL_ID=<paddleocr-model-id>
OCR_PROFILE_ID=paddleocr-intranet-v1
OCR_REVISION=<paddleocr-immutable-revision>
OCR_PROTOCOL_VERSION=2
OCR_REQUEST_TIMEOUT_MS=180000

FILE_MAX_ARCHIVE_DEPTH=3
FILE_MAX_COMPRESSION_RATIO=100
FILE_MAX_PAGES=2000
FILE_MAX_TOTAL_PIXELS=500000000
FILE_MAX_TABLE_CELLS=5000000
OCR_TEXT_COVERAGE_THRESHOLD=0.02
OCR_MIN_CONFIDENCE=0.75
PROCESSING_MAX_ATTEMPTS=3

# ---- 知识加工与质量 ----
CHUNKER_PROFILE_ID=structure-aware-medium-v1
CHUNKER_REVISION=1.0.0
TOKENIZER_ADAPTER=cl100k
TOKENIZER_PROFILE_ID=cl100k-base-local
CHUNK_CHILD_MAX_TOKENS=512
CHUNK_PARENT_MAX_TOKENS=1500
CHUNK_OVERLAP_TOKENS=64
CHUNK_DEDUP_MODE=SUPPRESS
QUALITY_RULE_VERSION=quality-medium-v1
QUALITY_MIN_NON_EMPTY_BLOCK_RATIO=0.6
QUALITY_REJECT_NON_EMPTY_BLOCK_RATIO=0.2
QUALITY_MIN_OCR_CONFIDENCE=0.75
QUALITY_MAX_GARBLED_RATIO=0.03
QUALITY_REJECT_GARBLED_RATIO=0.15
QUALITY_MAX_DUPLICATE_RATIO=0.4
QUALITY_REQUIRE_HEADING_AFTER_BLOCKS=20

# ---- LLM（OpenAI 兼容内网网关）----
LLM_ADAPTER=openai-compatible
LLM_BASE_URL=http://<glm-gateway-host>:<port>/v1
LLM_API_KEY=<glm-api-key-or-empty-token>
LLM_MODEL_ID=glm-4.7
LLM_PROFILE_ID=glm-4.7-intranet-integration-v1
LLM_REVISION=<glm-4.7-immutable-revision>
LLM_PROTOCOL_VERSION=1
LLM_CONNECT_TIMEOUT_MS=3000
LLM_REQUEST_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.1

# ---- Embedding（默认只启用 Dense；确认服务支持 Sparse 契约后再开启混合检索）----
EMBEDDING_ADAPTER=http
EMBEDDING_BASE_URL=http://<embedding-gateway-host>:<port>
EMBEDDING_API_KEY=
EMBEDDING_MODEL_ID=<embedding-model-id>
EMBEDDING_PROVIDER_NAME=<embedding-provider-name>
EMBEDDING_PROFILE_ID=embedding-intranet-integration-v1
EMBEDDING_REVISION=<embedding-immutable-revision>
EMBEDDING_PROTOCOL_VERSION=1
EMBEDDING_CONNECT_TIMEOUT_MS=3000
EMBEDDING_REQUEST_TIMEOUT_MS=30000
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DENSE_DIMENSION=<embedding-dense-dimension>
EMBEDDING_NORMALIZE_DENSE=true
# 若 /metadata 的 capabilities 同时有 sparse，再改为 dense,sparse，填写稀疏格式版本，
# 并把下方检索权重恢复为 0.65 / 0.35。只提供 Dense 时不得凭空假设 BGE-M3 契约。
EMBEDDING_OUTPUT_MODE=dense
EMBEDDING_MAX_INPUT_TOKENS=8192
EMBEDDING_TOKENIZER_REVISION=<embedding-tokenizer-immutable-revision>
EMBEDDING_SPARSE_FORMAT_VERSION=
EMBEDDING_DOCUMENT_TEMPLATE_VERSION=document-v1
EMBEDDING_QUERY_TEMPLATE_VERSION=query-v1
EMBEDDING_MAX_BATCH_TOKENS=32768
EMBEDDING_MAX_CONCURRENCY=4
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_BASE_DELAY_MS=250
EMBEDDING_MAX_QUEUED_ITEMS=5000

# ---- Reranker（BGE Reranker）----
RERANKER_ADAPTER=http
RERANKER_BASE_URL=http://<reranker-gateway-host>:<port>
RERANKER_API_KEY=
RERANKER_MODEL_ID=<reranker-model-id>
RERANKER_PROFILE_ID=reranker-intranet-integration-v1
RERANKER_REVISION=<reranker-immutable-revision>
RERANKER_PROTOCOL_VERSION=1
RERANKER_CONNECT_TIMEOUT_MS=3000
RERANKER_REQUEST_TIMEOUT_MS=15000
RERANKER_MAX_CANDIDATES=50
RERANKER_TOP_N=10
RERANKER_MAX_INPUT_TOKENS=8192

# ---- 索引构建与发布 ----
INDEXING_OVERALL_DEADLINE_MS=900000
INDEXING_VECTOR_WRITE_BATCH_SIZE=256
INDEXING_VECTOR_WRITE_MAX_ATTEMPTS=3
INDEXING_MANIFEST_RETENTION_DAYS=30
INDEXING_RECONCILE_INTERVAL_SECONDS=3600
INDEXING_MAINTENANCE_LEASE_SECONDS=300
INDEXING_MAINTENANCE_BATCH_SIZE=10
INDEXING_MAINTENANCE_MAX_ATTEMPTS=5
INDEXING_ROLLOUT_MAX_CASES=50
INDEXING_ROLLOUT_EVALUATION_TOP_K=5
INDEXING_ROLLOUT_MINIMUM_RECALL=0.9
INDEXING_ROLLOUT_LEASE_SECONDS=600
INDEXING_ROLLOUT_MAX_ATTEMPTS=3

# ---- 会话运行与事件 ----
RUN_FLOW_VERSION=rag-flow-v1
RUN_POLICY_VERSION=safe-answer-policy-v1
RUN_PROMPT_PROFILE_ID=rag-prompt-v1
RUN_VALIDATOR_PROFILE_ID=answer-validator-v1
RUN_DEADLINE_SECONDS=120
RUN_EVENT_RETENTION_SECONDS=86400
RUN_EVENT_STREAM_MAX_LENGTH=10000
RUN_EVENT_PUBLISH_BATCH_SIZE=100
RUN_EVENT_PUBLISH_LEASE_SECONDS=30
RUN_STREAM_TICKET_TTL_SECONDS=60
RUN_SSE_HEARTBEAT_SECONDS=15
RUN_SHORT_WINDOW_MESSAGES=20
RUN_CONTENT_STORAGE=AES_256_GCM
# 即使是联调环境也不要复用公开默认值。生成 Base64 编码的 32 字节随机密钥并妥善保存；
# 数据写入后更换该值会导致历史会话无法解密。
RUN_CONTENT_ENCRYPTION_KEY=<base64-encoded-32-random-bytes>
RUN_CONTENT_RETENTION_DAYS=30
RUN_MAINTENANCE_INTERVAL_SECONDS=60
RUN_MAINTENANCE_BATCH_SIZE=100

# ---- 查询规划与混合检索 ----
RETRIEVAL_PROFILE_ID=dense-medium-v1
RETRIEVAL_INITIAL_TOP_K=40
RETRIEVAL_FINAL_TOP_K=12
RETRIEVAL_RRF_K=60
RETRIEVAL_DENSE_WEIGHT=1
RETRIEVAL_SPARSE_WEIGHT=0
RETRIEVAL_MAX_PER_DOCUMENT=3
RETRIEVAL_MAX_PER_SECTION=2
RETRIEVAL_MINIMUM_RESULTS=3
RETRIEVAL_MAX_ROUNDS=2
RETRIEVAL_QUERY_CACHE_TTL_SECONDS=600

# ---- 证据与答案生成 ----
ANSWER_CONTEXT_TOKEN_BUDGET=12000
ANSWER_CONTEXT_MAX_PER_DOCUMENT=2
ANSWER_MIN_CONFIDENCE=0.58
ANSWER_LLM_EVIDENCE_RERANK_ENABLED=true
ANSWER_SEMANTIC_JUDGE_ENABLED=true
ANSWER_RERANK_FALLBACK_ENABLED=true
ANSWER_STRICT_STREAMING=true
ANSWER_MAX_REGENERATIONS=1
ANSWER_EXECUTION_INTERVAL_MS=1000
ANSWER_EXECUTION_BATCH_SIZE=10
ANSWER_EXECUTION_LEASE_SECONDS=60
ANSWER_CITATION_PREVIEW_CHARS=1200
EVALUATION_WORKER_INTERVAL_MS=2000
EVALUATION_WORKER_BATCH_SIZE=5
EVALUATION_WORKER_LEASE_SECONDS=60
EVALUATION_MAX_ATTEMPTS=3
EVALUATION_PENDING_POLL_SECONDS=2

# ---- 在线问答速率与并发舱壁 ----
TRAFFIC_GLOBAL_RATE_PER_MINUTE=600
TRAFFIC_GLOBAL_CONCURRENCY=200
TRAFFIC_USER_RATE_PER_MINUTE=60
TRAFFIC_USER_CONCURRENCY=4
TRAFFIC_ROLE_RATE_PER_MINUTE=300
TRAFFIC_ROLE_CONCURRENCY=100
TRAFFIC_SPACE_RATE_PER_MINUTE=300
TRAFFIC_SPACE_CONCURRENCY=50
TRAFFIC_LEASE_SECONDS=120

# ---- Milvus ----
VECTOR_STORE_ADAPTER=milvus
VECTOR_STORE_PROFILE_ID=milvus-intranet-dev-v1
# SDK 地址（host:port），不是 Attu 或 HTTP 页面地址。
MILVUS_ADDRESS=<milvus-host>:19530
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_TOKEN=
MILVUS_DATABASE=rag
MILVUS_TLS_ENABLED=false
MILVUS_COLLECTION_PREFIX=rag_chunks
MILVUS_ACTIVE_ALIAS=rag_chunks_active
MILVUS_CONNECT_TIMEOUT_MS=5000
MILVUS_REQUEST_TIMEOUT_MS=30000

# ---- 可观测性（内网测试默认关闭链路追踪）----
OTEL_TRACES_ENABLED=false
# 关闭追踪时不会访问该默认地址；将来启用再改为真实 OTLP HTTP Endpoint。
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAMESPACE=enterprise-rag

# ---- Web Console 暴露端口（仅此端口映射到宿主机）----
WEB_BIND=8080
