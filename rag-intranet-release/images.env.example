RAG_QUERY_SERVICE_IMAGE=enterprise-rag/rag-query-service:<release-tag>
INGESTION_WORKER_IMAGE=enterprise-rag/ingestion-worker:<release-tag>
SCHEDULER_WORKER_IMAGE=enterprise-rag/scheduler-worker:<release-tag>
DOCUMENT_PARSER_SERVICE_IMAGE=enterprise-rag/document-parser-service:<release-tag>
WEB_CONSOLE_IMAGE=enterprise-rag/web-console:<release-tag>
